{
    "name": "libfive-wasm-showcase",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Public demo gallery for libfive-wasm (not part of the npm package).",
    "scripts": {
        "dev": "vite",
        "build": "npm run -s docs && vite build",
        "preview": "vite preview",
        "check": "npm run -s docs && tsc --noEmit",
        "lint": "eslint src --max-warnings 0",
        "docs": "npm run -s docs:typedoc && npm run -s docs:compile",
        "docs:typedoc": "typedoc",
        "docs:compile": "node scripts/build-docs.mjs",
        "docs:check": "npm run -s docs:typedoc && npm run -s docs:compile -- --verify",
        "thumbnails:capture": "node scripts/capture-thumbnails.mjs"
    },
    "dependencies": {
        "highlight.js": "^11.11.1",
        "libfive-wasm": "file:..",
        "three": "^0.187.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^26.6.6",
        "@types/three": "^0.187.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "marked": "18.1.2",
        "puppeteer-core": "^25.16.0",
        "typedoc": "0.28.20",
        "typedoc-plugin-markdown": "4.14.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^7.3.7"
    }
}
