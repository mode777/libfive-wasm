{
  "name": "libfive-wasm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WebAssembly port of the libfive solid-modeling kernel (MPL-2.0 portions): async init(), typed raw C namespace, convenience Shape API.",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "golden": "vitest run tests/golden.test.ts",
    "golden:capture": "node scripts/capture-goldens.mjs",
    "check": "tsc --noEmit",
    "gen:stdlib": "node scripts/gen-stdlib-ts.mjs && node scripts/gen-stdlib-shims.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
