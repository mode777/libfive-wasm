{
  "name": "libfive-wasm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WebAssembly port of the libfive solid-modeling kernel (MPL-2.0 portions): async init(), typed raw C namespace, convenience Shape API.",
  "keywords": [
    "libfive",
    "wasm",
    "webassembly",
    "solid-modeling",
    "sdf",
    "implicit-surface",
    "cad",
    "mesh"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mode777/libfive-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/mode777/libfive-wasm/issues"
  },
  "homepage": "https://github.com/mode777/libfive-wasm#readme",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/debug",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:package": "node scripts/test-package.mjs",
    "golden": "vitest run tests/golden.test.ts",
    "golden:capture": "node scripts/capture-goldens.mjs",
    "check": "tsc --noEmit",
    "build:js": "node scripts/build-js.mjs",
    "prepack": "node scripts/build-js.mjs",
    "gen:stdlib": "node scripts/gen-stdlib-ts.mjs && node scripts/gen-stdlib-shims.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
