libfive-wasm carried patch 0001: Emscripten host guards

Upstream's top-level CMake eagerly discovers Qt, Guile, Python, pkg-config and
Threads, probes -march=native, and requires libpng. None of that is valid for a
wasm cross build (no host CPU, no pkg-config in the emscripten sysroot, no Qt,
no GPL bindings), and the vendored tree no longer contains the optional
targets.

This patch, applied by scripts/vendor-libfive.sh to the pinned tree:
  - defaults BUILD_STUDIO_APP / BUILD_GUILE_BINDINGS / BUILD_PYTHON_BINDINGS /
    BUILD_TESTS to OFF under EMSCRIPTEN (AD-001: MPL-2.0 kernel only);
  - skips the -march=native probe under EMSCRIPTEN (AD-008: portable baseline);
  - skips pkg-config, Boost, Guile, Eigen, PNG and Python discovery under
    EMSCRIPTEN (the build overlay supplies include dirs; -s USE_LIBPNG=1
    supplies png.h) (AD-016);
  - skips the Threads / -latomic requirement under EMSCRIPTEN (AD-014:
    single-threaded kernel).

Serves AD-001, AD-008, AD-013, AD-014, AD-016. Do not edit the vendored tree;
edit this patch and bump patch_digest in vendor/libfive.lock.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,6 +10,15 @@
 option(BUILD_PYTHON_BINDINGS "Build Python bindings" ON)
 option(ENABLE_DEBUG "Add debugging Symbols to the binaries" ON)
 
+# libfive-wasm (AD-001): only the kernel and C stdlib are compiled to wasm.
+# Studio, the Guile bindings and the Python bindings are GPL-2+ and out of
+# scope, so they default off and are never discovered under Emscripten.
+if(EMSCRIPTEN)
+    set(BUILD_STUDIO_APP OFF CACHE BOOL "Build Studio application (disabled for libfive-wasm)" FORCE)
+    set(BUILD_GUILE_BINDINGS OFF CACHE BOOL "Build Guile bindings (disabled for libfive-wasm)" FORCE)
+    set(BUILD_PYTHON_BINDINGS OFF CACHE BOOL "Build Python bindings (disabled for libfive-wasm)" FORCE)
+endif()
+
 option(LIBFIVE_PACKED_OPCODES
     "Tightly pack opcodes (breaks compatibility with older saved f-reps)"
     OFF)
@@ -58,9 +67,12 @@
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wextra ${LIBFIVE_DEBUGGING}-fPIC -pedantic -Werror=switch")
 
     # Sometimes this flag is not supported (e.g. on Apple Silicon)
-    check_cxx_compiler_flag("-march=native" MARCH_SUPPORTED)
-    if(MARCH_SUPPORTED)
-        set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -march=native")
+    # wasm has no host CPU to tune for (AD-008, AD-013); skip under Emscripten.
+    if(NOT EMSCRIPTEN)
+        check_cxx_compiler_flag("-march=native" MARCH_SUPPORTED)
+        if(MARCH_SUPPORTED)
+            set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -march=native")
+        endif()
     endif()
 
     set(CMAKE_CXX_FLAGS_DEBUG "-O0")
@@ -89,7 +101,7 @@
 
 ################################################################################
 # Find all packages here at the top level so we can print debugging info
-if(NOT MSVC)
+if(NOT MSVC AND NOT EMSCRIPTEN)
     # These packages have different naming conventions in MSVC vs Linux
     find_package(Boost REQUIRED)
     find_package(PkgConfig REQUIRED)
@@ -100,14 +112,18 @@
     endif()
 
     pkg_check_modules(EIGEN REQUIRED eigen3>=3.2.92)
-else()
+elseif(MSVC)
     find_package(eigen3 REQUIRED)
     find_package(boost REQUIRED 1.65.0)
 endif()
 
-# These packages have consistent names across OS's
-find_package(PNG REQUIRED)
-find_package(Python3 COMPONENTS Interpreter Development)
+# These packages have consistent names across OS's.
+# Under Emscripten the port supplies png.h via -s USE_LIBPNG=1 and no Python
+# toolchain is used, so neither discovery is required (AD-008, AD-016).
+if(NOT EMSCRIPTEN)
+    find_package(PNG REQUIRED)
+    find_package(Python3 COMPONENTS Interpreter Development)
+endif()
 
 # Both Windows and Linux will attempt to build the Studio UI
 if (BUILD_STUDIO_APP)
@@ -122,10 +138,10 @@
     endif()
 endif()
 
-if (UNIX AND NOT(APPLE))
+if (UNIX AND NOT(APPLE) AND NOT EMSCRIPTEN)
     find_package(Threads REQUIRED)
     set(CMAKE_CXX_LINK_FLAGS "${CMAKE_CXX_LINK_FLAGS} -latomic")
-endif(UNIX AND NOT(APPLE))
+endif(UNIX AND NOT(APPLE) AND NOT EMSCRIPTEN)
 
 ################################################################################
 # Inform the user which subsystems will be built and any missing deps
--- a/libfive/CMakeLists.txt
+++ b/libfive/CMakeLists.txt
@@ -4,6 +4,11 @@
 endif()
 
 option(BUILD_TESTS "Build test suite" ON)
+if(EMSCRIPTEN)
+    # The wasm build runs its own smoke/interval tests via scripts/ (AD-013,
+    # AD-015); upstream's GTest suite is not needed and not vendored.
+    set(BUILD_TESTS OFF CACHE BOOL "Build test suite (disabled for libfive-wasm)" FORCE)
+endif()
 
 add_subdirectory(src)
 add_subdirectory(stdlib)
