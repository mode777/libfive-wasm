+++ b/libfive/src/render/brep/worker_pool.inl
@@ -46,9 +46,6 @@
     LockFreeStack tasks(settings.workers);
     tasks.push({root, eval->getDeck()->tape, Neighbors(), settings.vol});
 
-    std::vector<std::future<void>> futures;
-    futures.resize(settings.workers);
-
     Root<T> out(root);
     std::mutex root_lock;
 
@@ -63,6 +60,14 @@
     }
 
